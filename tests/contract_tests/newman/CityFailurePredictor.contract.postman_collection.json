          ],
          "path": [
            "incidents",
            "{{incidentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404 Not Found after delete', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}