          }
        ],
        "url": {
          "raw": "{{baseUrl}}/incidents/{{incidentId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "incidents",
            "{{incidentId}}",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DESTROYED\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - missing token should fail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/incidents/all",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "incidents",
            "all"
          ]
        },
