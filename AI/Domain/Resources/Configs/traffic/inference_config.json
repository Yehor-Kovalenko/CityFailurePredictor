{
  "model": {
    "type": "xgboost",
    "path": "traffic_weights/xgboost/2026-06-14_13-36-24/model.joblib"
  },

  "features": {
    "window_size": 6,
    "use_hour": true,
    "use_day_of_week": true,
    "junction_ids": [1, 2, 3, 4]
  },

  "forecast": {
    "horizon": 24
  },

  "anomaly": {
    "z_threshold": 3.0,
    "min_relative_deviation": 0.5,
    "congestion_thresholds": {"1": 89, "2": 30, "3": 30, "4": 13}
  },

  "data": {
    "frequency": "1H",
    "target_column": "Vehicles",
    "group_column": "Junction"
  }
}