/mvnw text eol=lf
*.cmd text eol=crlf

# Generated build artifacts
**/dist/** linguist-generated=true
**/build/** linguist-generated=true
**/target/** linguist-generated=true
**/coverage/** linguist-generated=true
**/node_modules/** linguist-vendored=true

# Load/stress test generated reports
tests/load_tests/**/* linguist-generated=true

# Static/generated documentation and assets
docs/** linguist-documentation=true
architecture/** linguist-documentation=true
**/swagger-ui/** linguist-vendored=true
**/static/** linguist-generated=true

# Maven wrapper scripts
mvnw linguist-generated=true
mvnw.cmd linguist-generated=true

# Project-relevant languages
*.java linguist-detectable=true
*.ts linguist-detectable=true
*.tsx linguist-detectable=true
*.py linguist-detectable=true
*.xml linguist-detectable=true
*.yml linguist-detectable=true
*.yaml linguist-detectable=true
Dockerfile linguist-detectable=true